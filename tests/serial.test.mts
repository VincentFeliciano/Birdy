// Run with: node tests/serial.test.mts
// Drives the USB streamer against a simulated Marlin printer.
import assert from 'node:assert/strict'
import { classify, numbered, parseTemps, sendableLines } from '../src/engine/serial/marlin.ts'
import { streamGcode, type SerialLike, type StreamControl } from '../src/engine/serial/stream.ts'

let passed = 0
async function test(name: string, fn: () => Promise<void> | void) {
  try {
    await fn()
    passed++
    console.log(`ok  ${name}`)
  } catch (err) {
    console.error(`FAIL ${name}`)
    throw err
  }
}

interface SimOptions {
  /** Corrupt the checksum of these line numbers the first time they arrive (simulated noise). */
  noisyLines?: number[]
  /** Reply "echo:busy: processing" before the ok for commands matching this. */
  busyFor?: RegExp
  /** Never answer anything. */
  silent?: boolean
  /** Restart (send "start") after this many accepted lines. */
  rebootAfter?: number
}

/** A fake Marlin printer: checks line numbers and checksums, asks for resends, acknowledges. */
function simulatedPrinter(opts: SimOptions = {}) {
  const accepted: string[] = []
  const raw: string[] = []
  let expected = 0
  let numbering = false
  let out: ReadableStreamDefaultController<Uint8Array>
  const enc = new TextEncoder()
  const dec = new TextDecoder()
  let closed = false
  const say = (s: string) => {
    if (!closed) out.enqueue(enc.encode(`${s}\n`))
  }
  const noisy = new Set(opts.noisyLines ?? [])
  let pending = ''

  const handle = (line: string) => {
    raw.push(line)
    if (opts.silent) return
    const m = /^N(\d+) (.*)\*(\d+)$/.exec(line)
    if (!m) {
      // Unnumbered command (used for emergency stop).
      accepted.push(line)
      say('ok')
      return
    }
    const n = Number(m[1])
    const cmd = m[2]!
    let cs = 0
    const body = `N${n} ${cmd}`
    for (let i = 0; i < body.length; i++) cs ^= body.charCodeAt(i)
    let bad = cs !== Number(m[3])
    if (noisy.has(n)) {
      noisy.delete(n)
      bad = true
    }
    if (cmd.startsWith('M110')) {
      expected = Number(/N(\d+)/.exec(cmd.slice(4))?.[1] ?? 0) + 1
      numbering = true
      say('ok')
      return
    }
    if (bad) {
      say(`Error:checksum mismatch, Last Line: ${expected - 1}`)
      say(`Resend: ${expected}`)
      say('ok')
      return
    }
    if (numbering && n !== expected) {
      say(`Error:Line Number is not Last Line Number+1, Last Line: ${expected - 1}`)
      say(`Resend: ${expected}`)
      say('ok')
      return
    }
    expected = n + 1
    accepted.push(cmd)
    if (opts.busyFor?.test(cmd)) say('echo:busy: processing')
    if (opts.rebootAfter !== undefined && accepted.length === opts.rebootAfter) {
      say('start')
      return
    }
    say(`ok T:${200 + (accepted.length % 3)} /210 B:60.0 /60`)
  }

  const port: SerialLike & { closed: boolean } = {
    closed: false,
    readable: null,
    writable: null,
    async open() {
      ;(this as { readable: ReadableStream<Uint8Array> }).readable = new ReadableStream<Uint8Array>({ start: (c) => (out = c) })
      ;(this as { writable: WritableStream<Uint8Array> }).writable = new WritableStream<Uint8Array>({
        write(chunk) {
          pending += dec.decode(chunk)
          let i: number
          while ((i = pending.indexOf('\n')) >= 0) {
            const line = pending.slice(0, i)
            pending = pending.slice(i + 1)
            // Answer asynchronously, like a real serial link.
            setTimeout(() => handle(line), 0)
          }
        },
      })
    },
    async close() {
      this.closed = true
      closed = true
      try {
        out.close()
      } catch {
        /* already closed */
      }
    },
  }
  return { port, accepted, raw }
}

const GCODE = ['; generated by test', 'G28 ; home', 'M190 S60', 'M109 S210', 'G1 Z0.2 F600', '', 'G1 X10 Y10 E1 ; move', 'G1 X20 Y10 E2', 'M104 S0', 'M140 S0', 'M84'].join('\n')
const EXPECTED = ['G28', 'M190 S60', 'M109 S210', 'G1 Z0.2 F600', 'G1 X10 Y10 E1', 'G1 X20 Y10 E2', 'M104 S0', 'M140 S0', 'M84']
const fast = { baudRate: 115200, bootDelayMs: 5, silenceTimeoutMs: 400 }

await test('marlin: checksum, comment stripping, reply parsing', () => {
  assert.equal(numbered(0, 'M110 N0'), 'N0 M110 N0*125')
  assert.deepEqual(sendableLines('G28 ; home\n\n; only comment\n  G1 X1  \r\n'), ['G28', 'G1 X1'])
  assert.deepEqual(classify('Resend: 12'), { kind: 'resend', line: 12 })
  assert.deepEqual(classify('rs N7'), { kind: 'resend', line: 7 })
  assert.equal(classify('echo:busy: processing').kind, 'busy')
  assert.equal(classify('ok').kind, 'ok')
  assert.equal(classify('Error:Printer halted. kill() called!').kind, 'error')
  assert.deepEqual(parseTemps('ok T:209.8 /210.0 B:59.9 /60.0 @:0'), { hotend: 209.8, hotendTarget: 210, bed: 59.9, bedTarget: 60 })
  assert.deepEqual(classify(' T:150.0 /210.0 B:40 /60').kind, 'temps')
})

await test('stream: sends every line once, in order, and reports progress and temps', async () => {
  const sim = simulatedPrinter({ busyFor: /^M190/ })
  const progress: number[] = []
  let temps = 0
  const r = await streamGcode(sim.port, GCODE, fast, { paused: false, cancelled: false }, { onProgress: (s) => progress.push(s), onTemps: () => temps++ })
  assert.deepEqual(r, { kind: 'done' })
  assert.deepEqual(sim.accepted, EXPECTED)
  assert.equal(progress.at(-1), EXPECTED.length)
  assert.ok(temps > 0)
  assert.ok(sim.port.closed)
})

await test('stream: recovers from line noise with resend requests', async () => {
  const sim = simulatedPrinter({ noisyLines: [2, 5, 6] })
  const r = await streamGcode(sim.port, GCODE, fast, { paused: false, cancelled: false })
  assert.deepEqual(r, { kind: 'done' })
  assert.deepEqual(sim.accepted, EXPECTED, 'no line lost or duplicated')
  assert.ok(sim.raw.length > EXPECTED.length + 1, 'lines were resent')
})

await test('stream: cancel stops sending and turns heaters off', async () => {
  const sim = simulatedPrinter()
  const ctl: StreamControl = { paused: false, cancelled: false }
  const r = await streamGcode(sim.port, GCODE, fast, ctl, { onProgress: (s) => s === 3 && (ctl.cancelled = true) })
  assert.deepEqual(r, { kind: 'cancelled' })
  assert.deepEqual(sim.accepted.slice(0, 3), EXPECTED.slice(0, 3))
  assert.ok(!sim.accepted.includes('G1 X20 Y10 E2'))
  assert.deepEqual(sim.accepted.slice(-4), ['M104 S0', 'M140 S0', 'M107', 'M84'])
})

await test('stream: pause holds the next line until resumed', async () => {
  const sim = simulatedPrinter()
  const ctl: StreamControl = { paused: false, cancelled: false }
  let pausedAt = -1
  const done = streamGcode(sim.port, GCODE, fast, ctl, {
    onProgress: (s) => {
      if (s === 2 && pausedAt < 0) {
        ctl.paused = true
        pausedAt = s
      }
    },
  })
  await new Promise((r) => setTimeout(r, 300))
  assert.equal(sim.accepted.length, 2, 'nothing sent while paused')
  ctl.paused = false
  assert.deepEqual(await done, { kind: 'done' })
  assert.deepEqual(sim.accepted, EXPECTED)
})

await test('stream: a silent printer times out with a clear error', async () => {
  const sim = simulatedPrinter({ silent: true })
  const r = await streamGcode(sim.port, GCODE, fast, { paused: false, cancelled: false })
  assert.equal(r.kind, 'error')
  assert.match((r as { message: string }).message, /stopped responding/)
  assert.ok(sim.port.closed)
})

await test('stream: a printer that restarts mid-print stops the stream', async () => {
  const sim = simulatedPrinter({ rebootAfter: 4 })
  const r = await streamGcode(sim.port, GCODE, fast, { paused: false, cancelled: false })
  assert.equal(r.kind, 'error')
  assert.match((r as { message: string }).message, /restarted/)
})

console.log(`\n${passed} serial tests passed`)
